# Produccion: Faroles usa el MISMO proyecto Supabase que "Juntos por Akira",
# aislado en el schema `faroles`. Pega aca la URL y la anon key de ese proyecto
# (Supabase > Project Settings > API). La anon key es publica (va en el bundle);
# la seguridad la da RLS + la tabla faroles.admins, no el secreto de la key.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Solo para el modo demo LOCAL (sin nube, datos en IndexedDB): clave del panel /admin.
# Si no definis las VITE_SUPABASE_* de arriba, la app corre en este modo.
VITE_ADMIN_PASSWORD=faroles2026
